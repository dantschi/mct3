{
  "version": 1,
  "language": "Python",
  "runtime": {
    "command": ["python3", "--version"],
    "output_pattern": "^Python 3\\.12\\..*$"
  },
  "student_files": ["README.md", "starter/search.py", "tests/check.py"],
  "solution_files": ["solution/search.py"],
  "checks": [
    {
      "name": "import",
      "command": ["python3", "-c", "import search"],
      "starter": {"exit_code": 0},
      "solution": {"exit_code": 0}
    },
    {
      "name": "tests",
      "command": ["python3", "../tests/check.py"],
      "starter": {
        "exit_code": 1,
        "json": {
          "tests": 4,
          "failures": ["test_first", "test_notfound", "test_count", "test_empty"],
          "errors": []
        }
      },
      "solution": {
        "exit_code": 0,
        "json": {"tests": 4, "failures": [], "errors": []}
      }
    }
  ]
}
